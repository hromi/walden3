# Copy to .env and fill in. Never commit .env.
# 32 random bytes (hex) each, e.g.: python -c "import secrets;print(secrets.token_hex(32))"
WALDEN_IDENTITY_HMAC_KEY=
WALDEN_MEMORY_ENCRYPTION_KEY=   # BACK THIS UP: without it, all stored memory is unreadable
WALDEN_LLM_API_KEY=ollama       # any string for a local Ollama
WALDEN_API_TOKEN=
WALDEN_MATRIX_PASSWORD=         # the bot's Matrix account password
# Walrus Memory (see README, "Walrus Memory account")
MEMWAL_ACCOUNT_ID=0x...
MEMWAL_PRIVATE_KEY=             # delegate key: 32-byte Ed25519 seed, hex
